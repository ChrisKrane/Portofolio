---
interface Entry {
	title: string;
	org?: string;
	place?: string;
	period: string;
	description?: string;
	link?: { label: string; href: string };
}

interface Props {
	entries: Entry[];
}
---

<ol>
	{
		Astro.props.entries.map((entry) => (
			<li>
				<span class="dot" aria-hidden="true" />
				<p class="meta mono">{[entry.period, entry.place].filter(Boolean).join(' · ')}</p>
				<h3>
					{entry.title}
					{entry.org && <span class="org"> · {entry.org}</span>}
				</h3>
				{entry.description && <p class="description">{entry.description}</p>}
				{entry.link && (
					<a class="link mono" href={entry.link.href} target="_blank" rel="noopener">
						{entry.link.label} ↗
					</a>
				)}
			</li>
		))
	}
</ol>

<style>
	ol {
		list-style: none;
		margin: 0 0 0 0.3rem;
		padding: 0 0 0 1.4rem;
		border-left: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	li {
		position: relative;
	}

	/* Hollow dots on the line; the newest (first) entry gets a glowing filled one. */
	.dot {
		position: absolute;
		left: calc(-1.4rem - 5px);
		top: 0.4rem;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--bg);
		border: 1px solid var(--accent);
	}

	li:first-child .dot {
		background: var(--accent);
		box-shadow: 0 0 8px var(--accent);
	}

	.meta {
		margin: 0;
		font-size: 0.75rem;
		color: var(--muted);
	}

	h3 {
		margin: 0.15rem 0 0;
		font-size: 1.05rem;
		letter-spacing: -0.01em;
	}

	.org {
		color: var(--muted);
		font-weight: 400;
	}

	.description {
		margin: 0.35rem 0 0;
		color: var(--muted);
	}

	.link {
		display: inline-block;
		margin-top: 0.35rem;
		font-size: 0.8rem;
	}
</style>
