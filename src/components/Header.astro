---
import { localePath, switchLangPath, useTranslations, type Lang } from '../i18n/ui';
import { site } from '../site';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'en' ? 'no' : 'en';
const path = Astro.url.pathname;

const nav = [
	{ href: localePath(lang, 'projects'), label: t('nav.projects') },
	{ href: localePath(lang, 'devlog'), label: t('nav.devlog') },
	{ href: localePath(lang, 'about'), label: t('nav.about') },
];
const [name, tld] = site.domain.split('.');
---

<header>
	<div class="container bar">
		<a href={localePath(lang)} class="logo mono">{name}<span>.{tld}</span></a>
		<nav>
			{
				nav.map((item) => (
					<a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
			<a
				href={switchLangPath(path, otherLang)}
				class="control mono"
				hreflang={otherLang === 'no' ? 'nb' : 'en'}
				data-set-lang={otherLang}
				title={t('nav.lang')}
			>
				{otherLang.toUpperCase()}
			</a>
			<button type="button" class="control" id="theme-toggle" aria-label={t('nav.theme')} title={t('nav.theme')}>
				<svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
					></path>
				</svg>
				<svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
				</svg>
			</button>
		</nav>
	</div>
	<div class="glow-line sweep"></div>
</header>

<script>
	const root = document.documentElement;
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const next = root.dataset.theme === 'light' ? 'dark' : 'light';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
	});

	// Remember an explicit language choice so the root page sends the visitor back to it.
	document.querySelectorAll<HTMLElement>('[data-set-lang]').forEach((link) =>
		link.addEventListener('click', () => {
			try {
				localStorage.setItem('lang', link.dataset.setLang!);
			} catch {}
		}),
	);
</script>

<style>
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding-top: 1rem;
		padding-bottom: 1rem;
	}

	.logo {
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--text);
	}

	.logo span {
		color: var(--accent);
	}

	.logo:hover {
		text-decoration: none;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		font-size: 0.875rem;
	}

	nav a {
		color: var(--muted);
	}

	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--text);
		text-decoration: none;
	}

	.control {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 1.85rem;
		min-width: 1.85rem;
		padding: 0 0.5rem;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: transparent;
		color: var(--muted);
		font-size: 0.75rem;
		cursor: pointer;
	}

	.control:hover {
		color: var(--text);
		border-color: var(--accent);
	}

	.control svg {
		width: 15px;
		height: 15px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Show the icon of the theme you would switch to. */
	:global([data-theme='dark']) .moon,
	:global([data-theme='light']) .sun {
		display: none;
	}

	@media (max-width: 30rem) {
		nav {
			gap: 0.85rem;
		}
	}
</style>
