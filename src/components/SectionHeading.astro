---
interface Props {
	text: string;
}
---

<h2 class="mono">
	<span>// {Astro.props.text}</span>
	<span class="line" aria-hidden="true"></span>
</h2>

<style>
	h2 {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 3rem 0 1.25rem;
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0;
		text-transform: lowercase;
		color: var(--accent);
	}

	.line {
		flex: 1;
		height: 1px;
		background: linear-gradient(90deg, var(--accent), transparent);
		box-shadow: 0 0 6px var(--glow);
	}
</style>
