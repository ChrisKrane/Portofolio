---
import ProjectCard from './ProjectCard.astro';
import type { Lang } from '../i18n/ui';
import type { Project } from '../lib/content';

interface Props {
	projects: Project[];
	lang: Lang;
}

const { projects, lang } = Astro.props;

type Cell = { span: 2 | 3 | 4 | 6; rows: 1 | 2; large?: boolean; right?: boolean };

/**
 * Bento layout on a 6-column grid, so every row is filled whatever the project count.
 * Projects are taken three at a time, alternating between a "feature" group (one large
 * card next to two stacked small ones, flipping sides each time) and a row of three small
 * cards. One or two leftover projects stretch to fill the last row.
 */
function layout(count: number): Cell[] {
	if (count === 1) return [{ span: 6, rows: 1, large: true }];
	if (count === 2) return [{ span: 4, rows: 2, large: true }, { span: 2, rows: 2 }];

	const cells: Cell[] = [];
	for (let i = 0, group = 0; i < count; i += 3, group++) {
		const left = count - i;
		if (left >= 3 && group % 2 === 0) {
			const right = (group / 2) % 2 === 1;
			cells.push({ span: 4, rows: 2, large: true, right }, { span: 2, rows: 1 }, { span: 2, rows: 1 });
		} else if (left >= 3) {
			cells.push({ span: 2, rows: 1 }, { span: 2, rows: 1 }, { span: 2, rows: 1 });
		} else if (left === 2) {
			cells.push({ span: 3, rows: 1 }, { span: 3, rows: 1 });
		} else {
			cells.push({ span: 6, rows: 1 });
		}
	}
	return cells;
}

const cells = layout(projects.length);
---

<div class="bento">
	{
		projects.map((project, i) => {
			const { span, rows, large, right } = cells[i];
			return (
				<div class:list={['cell', { right }]} style={`--span: ${span}; --rows: ${rows}`}>
					<ProjectCard project={project} lang={lang} large={large} />
				</div>
			);
		})
	}
</div>

<style>
	.bento {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		grid-auto-rows: minmax(9rem, auto);
		grid-auto-flow: dense;
		gap: 0.75rem;
	}

	.cell {
		grid-column: span var(--span);
		grid-row: span var(--rows);
	}

	/* Large card on the right; the two small cards backfill the left thanks to dense flow. */
	.cell.right {
		grid-column: 3 / span 4;
	}

	@media (max-width: 40rem) {
		.bento {
			grid-template-columns: minmax(0, 1fr);
			grid-auto-rows: auto;
		}

		.cell,
		.cell.right {
			grid-column: auto;
			grid-row: auto;
		}
	}
</style>
