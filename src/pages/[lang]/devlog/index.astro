---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { langStaticPaths, useTranslations, type Lang } from '../../../i18n/ui';
import { getPosts } from '../../../lib/content';

export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = await getPosts(lang);
---

<Base lang={lang} title={t('devlog.title')}>
	<div class="container">
		<header class="page-header">
			<h1>{t('devlog.title')}</h1>
			<p>{t('devlog.intro')}</p>
		</header>
		{posts.length > 0 ? <PostList posts={posts} lang={lang} showDescription /> : <p>{t('devlog.empty')}</p>}
	</div>
</Base>
