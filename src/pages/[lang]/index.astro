---
import Base from '../../layouts/Base.astro';
import FeaturedProjects from '../../components/FeaturedProjects.astro';
import PostList from '../../components/PostList.astro';
import DotGlobe from '../../components/DotGlobe.astro';
import { langStaticPaths, localePath, useTranslations, type Lang } from '../../i18n/ui';
import { entrySlug, getPosts, getProjects } from '../../lib/content';

export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const projects = await getProjects(lang);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const posts = await getPosts(lang);

// "Currently building" follows the newest devlog post that belongs to a project.
const current = posts.find((post) => post.data.project);
const currentProject = current && projects.find((p) => entrySlug(p) === current.data.project);
---

<Base lang={lang}>
	<section class="hero">
		<div class="container hero-grid">
			<div>
				<p class="eyebrow mono">&gt; {t('hero.eyebrow')}</p>
				<h1>{t('hero.title')}</h1>
				<p class="tagline">{t('hero.tagline')}</p>
				{
					current && (
						<a
							class="current"
							href={localePath(lang, `devlog/${entrySlug(current)}`)}
							title={currentProject ? `${currentProject.data.title} · ${current.data.title}` : current.data.title}
						>
							<span class="dot" aria-hidden="true" />
							<span class="mono muted nowrap">{t('hero.current')}</span>
							<span class="current-title">
								{currentProject ? `${currentProject.data.title} · ${current.data.title}` : current.data.title}
							</span>
						</a>
					)
				}
			</div>
			<DotGlobe />
		</div>
	</section>

	<div class="container">
		{
			featured.length > 0 && (
				<section>
					<div class="section-head">
						<h2 class="label">{t('home.featured')}</h2>
						<a href={localePath(lang, 'projects')}>{t('home.allProjects')}</a>
					</div>
					<FeaturedProjects projects={featured} lang={lang} />
				</section>
			)
		}

		{
			posts.length > 0 && (
				<section>
					<div class="section-head">
						<h2 class="label">{t('home.latest')}</h2>
						<a href={localePath(lang, 'devlog')}>{t('home.allPosts')}</a>
					</div>
					<PostList posts={posts.slice(0, 3)} lang={lang} />
				</section>
			)
		}
	</div>
</Base>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		padding: 4.5rem 0 3.5rem;
	}

	/* Faint grid behind the hero that fades out towards the bottom. */
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image:
			linear-gradient(var(--grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid) 1px, transparent 1px);
		background-size: 28px 28px;
		background-position: center top;
		mask-image: linear-gradient(#000 40%, transparent);
	}

	/* Text on the left, globe on the right. The globe hides itself on small screens. */
	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		align-items: center;
		gap: 1.5rem;
	}

	@media (max-width: 40rem) {
		.hero-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		font-size: 0.875rem;
		color: var(--accent);
	}

	h1 {
		font-size: clamp(2.25rem, 7vw, 3.25rem);
	}

	.tagline {
		max-width: 32rem;
		margin: 0.75rem 0 0;
		font-size: 1.05rem;
		color: var(--muted);
	}

	/* Always one line; a long post title is cut off with an ellipsis (the full text is in the title attribute). */
	.current {
		display: inline-flex;
		align-items: center;
		max-width: 100%;
		gap: 0.5rem;
		margin-top: 1.5rem;
		padding: 0.35rem 0.85rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		font-size: 0.8rem;
		color: var(--text);
		transition: border-color 0.2s;
	}

	.nowrap,
	.dot {
		flex-shrink: 0;
		white-space: nowrap;
	}

	.current-title {
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.current:hover {
		border-color: var(--accent);
		text-decoration: none;
	}

	.muted {
		color: var(--muted);
	}

	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px var(--accent);
		animation: pulse 2.4s ease-in-out infinite;
	}

	@keyframes pulse {
		50% {
			opacity: 0.35;
		}
	}

	section + section {
		margin-top: 2.75rem;
	}

	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}

	.section-head a {
		font-size: 0.8rem;
	}
</style>
