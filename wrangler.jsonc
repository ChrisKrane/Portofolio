{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portofolio",
	"compatibility_date": "2026-10-01",
	// Static site: Cloudflare serves the Astro build output directly, no Worker code needed.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	// Required by `wrangler preview`, which Workers Builds runs for pull request branches.
	"previews": {}
}
